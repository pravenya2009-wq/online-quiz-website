# Copy this file to ".env" and fill in YOUR OWN values. Never commit ".env".
PORT=3000
NODE_ENV=development

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-or-secret-key-here

# Long random text used to sign login tokens (generate with the command in the README)
JWT_SECRET=replace-with-a-64-character-random-hex-string

# Secret word teachers type when registering as an instructor (choose your own)
INSTRUCTOR_INVITE_CODE=choose-a-teacher-secret
